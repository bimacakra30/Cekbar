# ============================================
# Bara System — Environment Variables
# ============================================

# Database (Prisma — MySQL/MariaDB)
DATABASE_URL="mysql://user:password@localhost:3306/db_name"

# App URL (domain publik aplikasi — digunakan untuk webhook callback)
APP_URL=https://yourdomain.com

# Session Secret (minimal 32 karakter, WAJIB diubah di production!)
SESSION_SECRET=your_session_secret_min_32_chars

# CEIRID API
CEIRID_API_URL=https://ceirid.com/api/v1
CEIRID_API_KEY=your_api_key
CEIRID_WEBHOOK_SECRET=your_secret_webhook

# GoPay Partner API Gateway
GOPAY_API_URL=https://api.example.com
GOPAY_API_KEY=your_gopay_api_key

# SMTP Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=no-reply@barasystem.my.id
